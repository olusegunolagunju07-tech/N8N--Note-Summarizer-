      "id": "cb5837ae-aa2d-489a-a369-0a203df0a2a0",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Summarize these lecture notes into key points a student can revise in 5 minutes. Notes: {{ $json.text }}.\n\nWrite all math in plain text using Unicode symbols. Do NOT use LaTeX,\ndollar signs, backslashes, or curly braces. Use τ, μ, ρ, ν, γ, ×, ≈, →,\nsuperscripts like m³ and 10⁻⁶, and write fractions as (a)/(b).\nExample: ρ = m/V = 0.3534 kg / 0.000355 m³ ≈ 995.5 kg/m³",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        496,
        0
      ],
      "id": "9fe2d0b8-6fd8-4dcc-842b-b7d101ff5273",
      "name": "Summarize Notes"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Create 10 practice questions with answers from these notes. Mix conceptual and calculation questions. Notes:{{ $('Extract from File').item.json.text }}\n\nWrite all math in plain text using Unicode symbols. Do NOT use LaTeX,\ndollar signs, backslashes, or curly braces. Use τ, μ, ρ, ν, γ, ×, ≈, →,\nsuperscripts like m³ and 10⁻⁶, and write fractions as (a)/(b).\nExample: ρ = m/V = 0.3534 kg / 0.000355 m³ ≈ 995.5 kg/m³",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        848,
        0
      ],
      "id": "1fd3bae8-16c8-4bf1-872a-7bd312cb5905",
      "name": "Generate Quiz"
    },
    {
      "parameters": {
        "jsCode": "const summary = $('Summarize Notes').first().json.text;\nconst quiz = $('Generate Quiz').first().json.text;\nconst email = $('On form submission').first().json.Email;\n\nreturn [{\n  json: {\n    email,\n    message: `STUDY SUMMARY\\n\\n${summary}\\n\\n-----\\n\\nPRACTICE QUIZ\\n\\n${quiz}`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        0
      ],
      "id": "f82f94ba-da73-497d-8bd3-dfaf7c7d3a7a",
      "name": "Combine Summary + Quiz"
    },
    {
      "parameters": {
        "mode": "markdownToHtml",
        "markdown": "={{ $json.message }}",
        "destinationKey": "html",
        "options": {
          "simpleLineBreaks": true,
          "tablesHeaderId": true
        }
      },
      "type": "n8n-nodes-base.markdown",
      "typeVersion": 1,
      "position": [
        1408,
        0
      ],
      "id": "a67d4f72-4a72-4d0e-8620-bbb8b8f6b3b2",
      "name": "Convert to HTML"
    },
    {
      "parameters": {
        "sendTo": "={{ $('Combine Summary + Quiz').item.json.email }}",
        "subject": "Your Study Summary and Quiz",
        "message": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1632,
